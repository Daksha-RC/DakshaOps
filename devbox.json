{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.2/.schema/devbox.schema.json",
  "packages": {
    "rustc": "1.86.0",
    "cargo": "1.86.0",
    "rustfmt": "1.86.0",
    "clippy": "1.86.0",
    "cargo-make": "0.37.24",
    "sqlx-cli": "0.8.6",
    "mirrord": "3.148.0",
    "helm": {
      "version": "latest",
      "excluded_platforms": ["aarch64-darwin"]
    },
    "kubectl": "latest",
    "yarn": "latest",
    "k9s": "latest",
    "doctl": "latest",
    "typescript": "latest"
  },
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null",
      "alias gs='git status'",
      "alias ll='ls -la'",
      "alias k=kubectl",
      "alias esc=pulumi"
    ],
    "scripts": {
      "test": ["echo \"Error: no test specified\" && exit 1"]
    }
  }
}
